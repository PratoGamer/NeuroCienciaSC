﻿<!-- Pagina Principal del Programa -->
@page "/"

<!-- Librerias y Dependencias -->
@using NeuroCienciaSC.Services
@inject NeuroCienciaService NeuroCiencia

<!-- Titulo de la Aplicacion -->
<div class="bg-dark text-light p-4 min-vh-100" data-bs-theme="dark">

    <div class="container-fluid d-flex rounded-3 justify-content-center align-items-center bg-body-tertiary border border-secondary py-3 mb-4 shadow">
        <div class="text-center">
            <h1 class="display-6 fw-bold text-info m-0">
                Neurociencia SC <i class="bi bi-person-arms-up"></i>
            </h1>

        </div>
    </div>

    <!-- Contenedor General -->
    <div class="container">
        <div class="row g-4">

            <div class="col-12 col-md-5">
                <div class="card bg-body-tertiary border-secondary shadow h-100">
                    <div class="card-body p-4">
                        <h3 class="h6 text-info mb-3"><i class="bi bi-terminal"></i> CONTROL DE SECUENCIA</h3>

                        <!-- Ingreso de Datos -->
                        <div class="mb-3">
                            <label class="form-label small text-secondary">Introduce un Número:</label>
                            <div class="input-group">
                                <input type="number" min="1" step="1" class="form-control bg-dark text-white border-secondary" @bind="nuevoNumero" placeholder="1" />
                                <button class="btn btn-info text-dark fw-bold" @onclick="AgregarNumero">
                                    <i class="bi bi-plus-lg"></i> Añadir
                                </button>
                            </div>
                        </div>

                        <!-- Botones para Calcular -->
                        <div class="d-grid gap-2 pt-2">
                            <button class="btn btn-outline-info fw-bold text-uppercase py-2" @onclick="ProcesarOrdenamiento" disabled="@(NeuroCiencia.secuencia.Count <= 1 || procesando)">
                                <i class="bi bi-cpu"></i> Calcular Mejor Orden
                            </button>
                            <button class="btn btn-outline-danger fw-bold text-uppercase py-2" @onclick="LimpiarTodo">
                                <i class="bi bi-trash3"></i> Limpiar Todo
                            </button>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Muestra de la Secuencia -->
            <div class="col-12 col-md-7">
                <div class="card bg-body-tertiary border-secondary shadow h-100">
                    <div class="card-body p-4">
                        <h3 class="h6 text-info mb-3"><i class="bi bi-sliders"></i> SECUENCIA INGRESADA</h3>

                        @if (NeuroCiencia.secuencia.Count == 0)
                        {
                            <div class="alert alert-dark border-secondary text-secondary text-center my-3" role="alert">
                                <i class="bi bi-inbox me-2"></i> La secuencia de nodos está vacía.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2 p-3 bg-dark rounded border border-secondary mb-3">
                                @foreach (var numero in NeuroCiencia.secuencia)
                                {
                                    <span class="badge bg-secondary p-2 fs-6 border border-light-subtle">@numero</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Muestra de la Tranformacion -->
            <div class="col-12 col-md-12">
                <div class="card bg-body-tertiary border-secondary shadow h-100">
                    <div class="card-body p-4">
                        <h3 class="h6 text-info mb-3">RESULTADOS DE TRANSFORMACION COMPARATIVA</h3>

                        <!-- Resultado de la Prueba -->
                        @if (calculado && !string.IsNullOrEmpty(NeuroCiencia.mejorOrden))
                        {
                            <div class="alert alert-info border-info bg-info-subtle text-light text-center mb-4 py-3 rounded shadow-sm">
                                <h4 class="h5 fw-bold mb-1">RESULTADO DE LA PRUEBA</h4>
                                La estrategia optima y mas economica para este conjunto de nodos es:
                                <span class="badge bg-primary text-white fs-5 text-uppercase px-3 ms-2 border border-dark">
                                    @NeuroCiencia.mejorOrden
                                </span>
                            </div>

                            <!-- Ruta Ascendente -->
                            <div class="row g-4">
                                <div class="col-12 col-lg-6">
                                    <div class="p-3 bg-dark bg-opacity-25 border border-secondary rounded h-100">
                                        <h4 class="h6 text-info mb-3 fw-bold"> RUTA ASCENDENTE</h4>
                                        <div class="alert alert-dark border-secondary d-flex justify-content-between align-items-center mb-3 py-2 text-warning small">
                                            <span>Costo Total Acumulado:</span>
                                            <span class="badge bg-warning text-dark fw-bold fs-6">@NeuroCiencia.SumarCostosAscendente()</span>
                                        </div>

                                        <ul class="list-group list-group-flush border border-secondary rounded mb-3" style="max-height: 350px; overflow-y: auto;">
                                            @foreach (var i in Enumerable.Range(0, NeuroCiencia.secuenciaOrdenadaAscendente.Count))
                                            {
                                                var paso = NeuroCiencia.secuenciaOrdenadaAscendente[i];
                                                <li class="list-group-item bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center py-2 small text-light">
                                                    <div>
                                                        <span class="badge bg-secondary me-1">P@(i + 1)</span>
                                                        Indice <strong class="text-info">@paso.indice</strong>: [@paso.valorAntes] -> <span class="badge bg-info text-dark">@paso.operacion</span> -> [@paso.valorDespues]
                                                    </div>
                                                    <span class="text-warning small fw-bold">+@NeuroCiencia.costosAscendente[i]</span>
                                                </li>
                                            }
                                        </ul>

                                        <div class="p-3 bg-dark rounded border border-success">
                                            <span class="text-success d-block small mb-2 fw-bold">Secuencia Final Ordenada:</span>
                                            @foreach (var n in NeuroCiencia.secuenciaFinalAscendente)
                                            {
                                                <span class="badge bg-success me-1 p-2 fs-6 border border-light-subtle">@n</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Ruta Descendente -->
                                <div class="col-12 col-lg-6">
                                    <div class="p-3 bg-dark bg-opacity-25 border border-secondary rounded h-100">
                                        <h4 class="h6 text-danger mb-3 fw-bold">RUTA DESCENDENTE</h4>
                                        <div class="alert alert-dark border-secondary d-flex justify-content-between align-items-center mb-3 py-2 text-warning small">
                                            <span>Costo Total Acumulado:</span>
                                            <span class="badge bg-warning text-dark fw-bold fs-6">@NeuroCiencia.SumarCostosDescendente()</span>
                                        </div>

                                        <ul class="list-group list-group-flush border border-secondary rounded mb-3" style="max-height: 350px; overflow-y: auto;">
                                            @foreach (var i in Enumerable.Range(0, NeuroCiencia.secuenciaOrdenadaDescendente.Count))
                                            {
                                                var paso = NeuroCiencia.secuenciaOrdenadaDescendente[i];
                                                <li class="list-group-item bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center py-2 small text-light">
                                                    <div>
                                                        <span class="badge bg-secondary me-1">P@(i + 1)</span>
                                                        Indice <strong class="text-info">@paso.indice</strong>: [@paso.valorAntes] -> <span class="badge bg-info text-dark">@paso.operacion</span> -> [@paso.valorDespues]
                                                    </div>
                                                    <span class="text-warning small fw-bold">+@NeuroCiencia.costosDescendente[i]</span>
                                                </li>
                                            }
                                        </ul>

                                        <div class="p-3 bg-dark rounded border border-danger">
                                            <span class="text-danger d-block small mb-2 fw-bold">Secuencia Final Ordenada:</span>
                                            @foreach (var n in NeuroCiencia.secuenciaFinalDescendente)
                                            {
                                                <span class="badge bg-danger me-1 p-2 fs-6 border border-light-subtle">@n</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        // No se han Ingresado Numeros
                        else
                        {
                            <p class="text-secondary small m-0 text-center py-4">
                                Ingrese al menos 2 numeros en el panel de control y presione "Calcular".
                            </p>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Codigo de C# -->
@code {
    // Variables para el Control
    private int nuevoNumero = 1;
    private bool calculado = false;
    private bool procesando = false;

    // Funcion para Agregar un Numero a la Secuencia
    private void AgregarNumero()
    {
        // Verificar que sea Entero y Positivo
        if (nuevoNumero > 0)
        {
            NeuroCiencia.secuencia.Add(nuevoNumero);
            calculado = true;
        }

    }

    // Funcion para Procesar el Orden Ascendente
    private async Task ProcesarOrdenamiento()
    {
        if (NeuroCiencia.secuencia.Count > 1 && !procesando)
        {
            try
            {
                procesando = true;
                await NeuroCiencia.CalcularOrdenMinimo();
				calculado = true;
            }
            finally
            {
				procesando = false;
            }
        }

    }

    // Funcion para Limpiar la Secuencia y Reiniciar el Proceso
    private void LimpiarTodo()
    {
        NeuroCiencia.secuencia.Clear();
        NeuroCiencia.secuenciaOrdenadaAscendente.Clear();
        NeuroCiencia.secuenciaOrdenadaDescendente.Clear();
        NeuroCiencia.costosAscendente.Clear();
        NeuroCiencia.costosDescendente.Clear();
        NeuroCiencia.secuenciaFinalAscendente.Clear();
        NeuroCiencia.secuenciaFinalDescendente.Clear();
        NeuroCiencia.mejorOrden = string.Empty;
        nuevoNumero = 1;
        calculado = false;
    }

}